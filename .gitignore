# Data — raw sources stay out; specific processed artefacts are bundled
# (see exceptions below) so Streamlit Cloud renders directly from the repo.
data/raw/
data/interim/
data/processed/*
*.nc
*.tif
*.feather

# ── Exceptions: bundle these small processed artefacts ──────────────
# dataset.parquet is no longer bundled: 351.7 MB on 2026-10-01, over Knot's 100 MB
# safety limit, which held every auto-commit. Kept on disk only (owner decision).
!data/processed/dataset.policy.json
!data/processed/cmip6_nuts3.parquet

# Bundle the fused-model prediction caches (small; recomputing needs
# checkpoints we do not distribute).
!results/metrics/fusion_predictions_val.parquet
!results/metrics/fusion_predictions_test.parquet

# Results
results/checkpoints/
!results/checkpoints/*.pipeline.json
results/metrics/*.json
!results/metrics/feature_policy.json
results/figures/*.png
results/figures/*.pdf
!results/figures/.gitkeep

# Zenodo staging (built by a release script, not committed)
release/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.key
gee-service-account.json
cred.txt
*.credentials
*_token.txt

# New land-eng noise (all safe to skip)
lightning_logs/
data/processed/dataset.pre_landfeatures.parquet
data/processed/gee_satellite.parquet
data/processed/static/dem_features.parquet
data/processed/static/landcover_features.parquet
data/processed/static/phenology_proxy.parquet
data/processed/dataset.pre_land.*.parquet
results/checkpoints_archive/
results/checkpoints/_pre_landfeatures_*/
results/logs/
*.py.bak

# Deleted page. Something outside git (an editor buffer) keeps rewriting it to
# disk in a state that raises SyntaxError on U+2014 outside a string literal,
# which breaks `compileall` and the preflight gate. It is not registered in
# nav.py and Streamlit never serves it.
dashboard/pages/01_Problem.py
dashboard/pages/18_Geographic.py

# logs of cluster jobs (scripts/sbatch_*.sh)
slurm_logs/

# Private cluster helpers (kept outside the repository)
scripts/preflight.sh
scripts/run_finetune.sh
scripts/orchestrate_retrain_landfeatures.sh
scripts/68_compute_cost.py
scripts/cropaware_watcher.sh
checkpoints/
